# MySQL
MYSQL_ROOT_PASSWORD=mysql
MYSQL_DATABASE=demo

# Spring Datasource
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/demo?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=mysql

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# ECS Logging
SPRING_LOG_SERVICE_NAME=Demo
SPRING_LOG_VERSION=1
SPRING_LOG_NODE_NAME=primary

SPRING_REDIS_HOST=
SPRING_REDIS_PORT=
SPRING_REDIS_PASSWORD=

# Kafka. `docker compose up` already points the app at the compose broker.
# To run the app on the host against it, use:
# SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Mail. `docker compose up` already points the app at Mailpit (inbox: http://localhost:8025).
# To run the app on the host against the compose Mailpit, use:
#   SPRING_MAIL_HOST=localhost  SPRING_MAIL_PORT=1025  SPRING_MAIL_USERNAME=dev  SPRING_MAIL_PASSWORD=dev
# Leave unset to use the Resend defaults.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

AUTH_EMAIL_FROM=

OTEL_EXPORTER_OTLP_ENDPOINT= http://grafana:4318
# Base URL of the frontend, used in email links (invitations: <FRONTEND_URL>/accept-invitation?code=...).
# Defaults to the Vite dev server; `docker compose up` points it at the frontend service (port 8081).
FRONTEND_URL=http://localhost:5173
